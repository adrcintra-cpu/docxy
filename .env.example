# ── Supabase ───────────────────────────────────────────────
# Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Banco (Project Settings › Database › Connection string) ─
# Pooler (porta 6543) para a aplicação
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Conexão direta (porta 5432) para migrações
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── Aplicação ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provedores OAuth ativados no Supabase (Authentication › Providers).
# Lista separada por vírgula: azure,google,apple. Vazio = só e-mail e senha.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Primeiro acesso sem terminal: o primeiro login deste e-mail cria a organização e o torna administrador.
# Só age enquanto não existir nenhuma organização no banco.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ORG_NAME=

# ── Leitura de documentos ──────────────────────────────────
# Segredo do agendador que chama /api/jobs/process (Authorization: Bearer ...)
CRON_SECRET=
# OCR de PDFs digitalizados (requer: npm install tesseract.js @napi-rs/canvas)
OCR_ENABLED=false
OCR_LANG=por

# ── Inteligência artificial (opcional) ─────────────────────
# Sem provedor, extração, assistente e resumos funcionam por regras, sem enviar nada para fora.
# Com provedor, a organização ainda precisa autorizar em Extrator › Configurações de IA,
# e documentos marcados como confidenciais nunca são enviados.
# none | anthropic | openai (openai = qualquer API compatível, inclusive Azure/local via AI_BASE_URL)
AI_PROVIDER=none
# Padrão do Anthropic: claude-sonnet-5-5. Obrigatório para openai.
AI_MODEL=
# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=60000
