{
  "name": "docxy",
  "version": "0.1.0",
  "private": true,
  "description": "Docxy — plataforma inteligente de gestão e comparação de documentos",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:security": "prisma db execute --schema prisma/schema.prisma --file supabase/sql/001_security.sql",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "vercel-build": "bash scripts/vercel-build.sh"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jszip": "3.10.1",
    "lucide-react": "0.544.0",
    "next": "15.5.4",
    "pdfjs-dist": "6.2.108",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "0.1.77",
    "tesseract.js": "6.0.1"
  }
}
